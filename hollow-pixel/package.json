{
  "name": "the-hollow-between-seasons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sprites": "node scripts/export-item-manifest.mjs",
    "forge:bridge": "node scripts/forge-bridge.mjs",
    "forge:validate-agent": "node scripts/validate-forge-agent.mjs",
    "prebuild": "npm run sprites",
